{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path((?!(public-config|omnidimension)$).*)",
      "destination": "https://REPLACE-WITH-BACKEND-HOST/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), microphone=(self), camera=(), payment=()"
        }
      ]
    },
    {
      "source": "/(.*).(js|css|png|jpg|jpeg|svg|woff|woff2|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/public-config.js": {
      "includeFiles": "public-auth-config.json"
    },
    "api/omnidimension.js": {
      "includeFiles": "{public-auth-config.json,omnidimension-contract.json}",
      "maxDuration": 40
    }
  }
}
