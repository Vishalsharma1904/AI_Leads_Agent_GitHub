# Public PWA proxy destination. Supply in the mobile Vercel project.
RUDRA_BACKEND_URL=https://your-api-host.example
# Supply these in the existing backend; retain all existing server-side secrets.
APP_ENV=production
DATABASE_URL=postgresql://copy-real-supabase-connection-string
PGOPTIONS=-csearch_path=rudra_mobile_backend
PGSSLMODE=require
AUTO_CREATE_SCHEMA=false
CORS_ORIGINS=https://your-mobile-host.example,http://localhost:3210,http://localhost:3000
ALLOWED_HOSTS=your-api-host.example
CONNECTOR_PUBLIC_BASE_URL=https://your-api-host.example
SUPABASE_REDIRECT_URL=https://your-mobile-host.example/
