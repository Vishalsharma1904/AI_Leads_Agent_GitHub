# Copy this file to .env and fill in real values. Never commit the real .env file.

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://admin:adminpassword@localhost:5432/ai_calling_agent

# ── OpenRouter (Jarvis's primary LLM brain — free tier) ────
# Get free keys at https://openrouter.ai/keys — comma-separate multiple keys
# to auto-rotate when one hits its rate limit.
OPENROUTER_API_KEYS=sk-or-v1-xxxxxxxx,sk-or-v1-yyyyyyyy

# Comma-separated list of free-tier models to cascade through, best first.
JARVIS_FREE_MODELS=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat-v3.1:free,deepseek/deepseek-r1:free,qwen/qwen-2.5-72b-instruct:free

# ── Exotel (India telephony — outbound/inbound calling) ─────
# Get these from your Exotel dashboard: https://my.exotel.com
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_SUBDOMAIN=api.in.exotel.com
# Your Exophone (purchased/verified caller ID number for outbound calls)
EXOTEL_CALLER_ID=

# Public wss:// domain Exotel will stream call audio to. In development, use
# an ngrok/localtunnel HTTPS URL's hostname (without the wss:// prefix).
PUBLIC_WSS_DOMAIN=your-domain.example.com

# ── Supabase Auth (single source of truth for identity) ─────
# The publishable key is safe for the browser. Never put a secret/service-role
# key here in frontend files or expose it from /api/public-config.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx
# Only the backend may use this legacy verification secret, if your project
# still signs access tokens with HS256. Prefer Supabase JWKS/ES256 when enabled.
SUPABASE_JWT_SECRET=
SUPABASE_REDIRECT_URL=http://localhost:3000/

# ── Google integrations (not used for Clavis authentication) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SHEETS_REDIRECT_URI=http://localhost:3000/oauth/google/callback
CREDENTIAL_MASTER_KEY=replace-with-at-least-32-random-characters
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1
MAX_REQUEST_BYTES=10485760
RATE_LIMIT_PER_MINUTE=60
# Bounded public-site enrichment. It never bypasses CAPTCHAs or login walls.
LEAD_WEBSITE_CRAWLER_ENABLED=true
LEAD_CRAWL_MAX_PAGES=3
LEAD_CRAWL_MAX_CONCURRENCY=3
# Optional signed token for Exotel -> /ws/audio stream authentication.
EXOTEL_STREAM_TOKEN=replace-with-a-long-random-stream-token
