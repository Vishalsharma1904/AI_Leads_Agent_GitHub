# Copy this file to .env and fill in real values. Never commit the real .env file.

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://admin:adminpassword@localhost:5432/ai_calling_agent

# ── OpenRouter (Jarvis's primary LLM brain — free tier) ────
# Get free keys at https://openrouter.ai/keys — comma-separate multiple keys
# to auto-rotate when one hits its rate limit.
OPENROUTER_API_KEYS=sk-or-v1-xxxxxxxx,sk-or-v1-yyyyyyyy

# Comma-separated list of free-tier models to cascade through, best first.
JARVIS_FREE_MODELS=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat-v3.1:free,deepseek/deepseek-r1:free,qwen/qwen-2.5-72b-instruct:free

# ── Exotel (India telephony — outbound/inbound calling) ─────
# Get these from your Exotel dashboard: https://my.exotel.com
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_SUBDOMAIN=api.in.exotel.com
# Your Exophone (purchased/verified caller ID number for outbound calls)
EXOTEL_CALLER_ID=

# Public wss:// domain Exotel will stream call audio to. In development, use
# an ngrok/localtunnel HTTPS URL's hostname (without the wss:// prefix).
PUBLIC_WSS_DOMAIN=your-domain.example.com

# ── Supabase Auth (single source of truth for identity) ─────
# The publishable key is safe for the browser. Never put a secret/service-role
# key here in frontend files or expose it from /api/public-config.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx
# Only the backend may use this legacy verification secret, if your project
# still signs access tokens with HS256. Prefer Supabase JWKS/ES256 when enabled.
SUPABASE_JWT_SECRET=
SUPABASE_REDIRECT_URL=http://localhost:3000/
# Verified Supabase accounts allowed to read product insights and bug reports.
DEVELOPER_EMAILS=vishalsharma190405@gmail.com

# ── Google integrations (not used for Clavis authentication) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SHEETS_REDIRECT_URI=http://localhost:3000/oauth/google/callback
CREDENTIAL_MASTER_KEY=replace-with-at-least-32-random-characters
# Public HTTPS URL of the FastAPI server. Register the callback paths below
# in each provider dashboard. In local development, localhost:8000 works for
# Google/GitHub; Meta/Slack may require a temporary HTTPS tunnel.
CONNECTOR_PUBLIC_BASE_URL=http://localhost:8000
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
APP_ENV=development
# Cloud Groq/Cartesia voice does not need a local Kokoro model at startup.
# Enable only for a dedicated local Exotel voice machine.
CLAVIS_WARM_KOKORO=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3210
ALLOWED_HOSTS=localhost,127.0.0.1
MAX_REQUEST_BYTES=10485760
RATE_LIMIT_PER_MINUTE=60
# Bounded public-site enrichment. It never bypasses CAPTCHAs or login walls.
LEAD_WEBSITE_CRAWLER_ENABLED=true
LEAD_CRAWL_MAX_PAGES=3
LEAD_CRAWL_MAX_CONCURRENCY=3
# Optional signed token for Exotel -> /ws/audio stream authentication.
EXOTEL_STREAM_TOKEN=replace-with-a-long-random-stream-token

# ── Payments (Razorpay) ──────────────────────────────────────────────
# Dashboard → Settings → API Keys. Without these /api/v1/billing/order
# returns 503 and the app shows "payments not switched on".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks. Point it at
#   https://<your-backend>/api/v1/billing/webhook
# and subscribe to payment.captured. This is what activates a plan when the
# customer closes the tab before the callback runs.
RAZORPAY_WEBHOOK_SECRET=

# ── Operator console ─────────────────────────────────────────────────
# Comma-separated e-mails that may open /api/v1/limits/admin/* and see every
# tenant's usage. Deliberately an env var and NOT a database column: a role in
# the database is one bad query away from a customer promoting themselves.
CLAVIS_ADMIN_EMAILS=

# ── Platform API keys (optional) ──────────────────────────────────────
# Set these and every customer runs on YOUR keys without ever seeing one.
# A tenant that saves its own key in the app overrides the matching value.
# These are used server-side only and are never sent to any client.
SARVAM_API_KEY=
TOUGHTONGUE_API_KEY=
APIFY_API_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
